# ==============================================================================
# Discord AI Bot - Environment Configuration Template
# ==============================================================================
# このファイルをコピーして `.env` を作成し、実際の値を設定してください。
# cp .env.example .env

# --- Discord Settings ---
# Discord Bot トークン (Discord Developer Portal から取得)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# 複数Bot並行稼働時用の個別Botトークン（各コンフィグごとに個別プレフィックス付きで定義可能）
# 例: config_img.py 用 -> IMG_DISCORD_TOKEN
# 例: config_shanks.py 用 -> SHANKS_DISCORD_TOKEN
# 例: config_test-server.py 用 -> TEST_SERVER_DISCORD_TOKEN
# IMG_DISCORD_TOKEN=YOUR_IMG_BOT_TOKEN_HERE
# SHANKS_DISCORD_TOKEN=YOUR_SHANKS_BOT_TOKEN_HERE

# 対象 Discord サーバー (Guild) ID（個別プレフィックス例: IMG_DISCORD_GUILD_ID）
DISCORD_GUILD_ID=123456789012345678

# Botプロフィール欄（Discord自己紹介/About Me）の感情・理由同期
# EMOTION_BIO_ENABLED=true
# 個別コンフィグ用（例: テスト用Botでプロフィールを更新したくない場合は false に設定）
# TEST_SERVER_EMOTION_BIO_ENABLED=false
# 同期対象Botコンフィグ限定（カンマ区切り、指定したコンフィグのみがグローバルBioを更新）
# EMOTION_BIO_TARGET_CONFIGS=config_img

# AI Bot が常駐・応答するメインチャンネルID
OLLAMA_CHANNEL_ID=123456789012345678

# AI Bot がたまに発言するサブチャンネルID（カンマ区切り）
OTHER_CHANNEL_IDS=123456789012345678,123456789012345679

# サブチャンネルでの発言間隔（発言数）のランダム最小/最大
OTHER_CHANNEL_RANDOM_MIN=5
OTHER_CHANNEL_RANDOM_MAX=10

# コマンド同期スコープ ('guild' または 'global')
APP_COMMAND_SYNC_SCOPE=guild

# 起動するペルソナ設定 ('config_shanks', 'config_img', etc.)
OLLAMA_BOT_CONFIG=config_shanks


# --- Ollama / LLM Settings ---
# Ollama または llama-server のエンドポイント
# ホストマシン直接起動時: http://127.0.0.1:11434
# Docker Compose 起動時: http://ollama:11434 (local プロファイル利用時) または http://host.docker.internal:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# メイン会話モデル名
OLLAMA_MAIN_MODEL=shanks-local-qwen36-a3b-jpn

# 画像認識（Vision）モデル名
OLLAMA_VISION_MODEL=shanks-local-qwen36-a3b-jpn

# 中間タスク/分類モデル名
OLLAMA_CLASSIFIER_MODEL=middle-llm
OLLAMA_MIDDLE_MODEL=middle-llm

# モデルのメモリ保持時間 (秒。-1 は常駐、0 は即座にアンロード)
OLLAMA_MAIN_KEEP_ALIVE=-1
OLLAMA_CLASSIFIER_KEEP_ALIVE=0
OLLAMA_MIDDLE_KEEP_ALIVE=120

# llama-server 等の OpenAI 互換 API を使用する場合は true
OLLAMA_USE_OPENAI_API=false


# --- Agent Autonomous Behavior (自発発話・プロアクティブ行動) ---
AGENT_PROACTIVE_POST_ENABLED=true
# 人間の最後の発言から自発発言を許可する最小放置時間（秒、デフォルト45分: 2700）
AGENT_PROACTIVE_MIN_IDLE_SEC=2700
# 自発発言のクールダウン（秒、デフォルト3時間: 10800）
AGENT_PROACTIVE_COOLDOWN_SEC=10800
# 自発発言をトリガーする退屈度 (0.0〜1.0)
AGENT_BOREDOM_TRIGGER=0.82
# 退屈度が最大(1.0)に達する放置時間（秒、デフォルト4時間: 14400）
AGENT_BOREDOM_FULL_SEC=14400
# 自発判定ループ周期（秒、デフォルト15分: 900）
AGENT_TICK_INTERVAL_SEC=900


# --- Web Research & Chrome MCP Settings ---
# Chrome MCP サーバーエンドポイント
WEB_RESEARCH_MCP_URL=http://127.0.0.1:12306/mcp
WEB_RESEARCH_MCP_TIMEOUT_SEC=20
MCP_CHROME_BOT_PROFILE_ENABLED=1
# MCP_CHROME_BOT_OS_USER=mcpchrome
# MCP_CHROME_EXTENSION_PATH=


# --- 新機能群設定 ---
# === 機能1: フォローアップ（Prospective Memory） ===
FOLLOWUP_ENABLED=true
FOLLOWUP_MIN_PRIORITY=0.5
FOLLOWUP_MAX_PER_USER=5

# === 機能2: 生活リズム（静かな時間帯） ===
BOT_QUIET_HOURS_ENABLED=false
BOT_QUIET_HOURS_START=01:00
BOT_QUIET_HOURS_END=07:00

# === 機能3: 返信送信作法 ===
REPLY_SPLIT_ENABLED=true
REPLY_SPLIT_MAX_CHUNKS=3
REPLY_TYPING_SEC_PER_CHAR=0.03
REPLY_REACTION_ONLY_RATE=0.0

# === 機能4: 音声・動画メディア ===
MEDIA_AUDIO_ENABLED=false
MEDIA_VIDEO_ENABLED=false
MEDIA_ASR_MODEL=whisper-1
MEDIA_VIDEO_MAX_FRAMES=4
MEDIA_DOWNLOAD_MAX_MB=25
MEDIA_ASR_TIMEOUT_SEC=60.0

# === 機能5: タスクモード（/ask） ===
ASK_COMMAND_ENABLED=true
ASK_MAX_SOURCES=5
ASK_USER_COOLDOWN_SEC=30.0

# === 機能6: リマインダー（/remind） ===
REMIND_ENABLED=true
REMIND_TICK_SEC=60.0
REMIND_MAX_PER_USER=20
REMIND_MAX_DELAY_DAYS=30

# === 機能7: 留守中まとめ（/catchup） ===
CATCHUP_ENABLED=true
CATCHUP_MAX_HOURS=72
CATCHUP_MAX_MESSAGES=300
CATCHUP_COOLDOWN_SEC=60.0

# --- 画像検索・探索（SauceNAO / trace.moe / Danbooru） ---
IMAGE_SEARCH_SAUCENAO_ENABLED=true
SAUCENAO_API_KEY=
IMAGE_SEARCH_TRACEMOE_ENABLED=true
IMAGE_SEARCH_VISION_VERIFY_ENABLED=true
IMAGE_SEARCH_MAX_CANDIDATES=5
IMAGE_SEARCH_VERIFY_TOP_N=3
IMAGE_SEARCH_API_TIMEOUT_SEC=15.0

IMAGE_FIND_ENABLED=true
IMAGE_FIND_MAX_CANDIDATES=12
IMAGE_FIND_MAX_RESULTS=5
IMAGE_FIND_MIN_SCORE=60
IMAGE_FIND_ALLOW_EXPLICIT=false
DANBOORU_LOGIN=
DANBOORU_API_KEY=


